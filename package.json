{
  "name": "@cityofzion/dora-ts",
  "version": "0.6.1",
  "description": "A typescript SDK for the dora blockchain data aggregator by COZ.",
  "license": "Apache-2.0",
  "main": "dist/index",
  "types": "dist/index",
  "repository": {
    "type": "git",
    "url": "https://github.com/CityOfZion/dora-sdk-ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "private": false,
  "scripts": {
    "prepare": "husky install",
    "prebuild": "rimraf dist",
    "build": "tsc",
    "test": "mocha 'src/**/*.test.ts'",
    "fmt": "prettier --write ./src/**/*.ts",
    "precommit": "lint-staged",
    "docs": "typedoc --out docs/",
    "publishDocs": "aws sy sync ./docs s3://neoscan/prod/documentation --acl public-read"
  },
  "dependencies": {
    "axios": "1.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "chai": "^6.2.0",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "husky": "^9.1.7",
    "lint-staged": "^13.2.3",
    "mocha": "^11.7.4",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "ts-node": "^10.9.2",
    "typedoc": "^0.24.8",
    "typescript": "^5.1.6",
    "typescript-eslint": "^8.46.3"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  }
}
